{
  "name": "naive-agent",
  "version": "0.0.0",
  "description": "naive agent",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "continue": "tsx src/index.ts --continue",
    "lint": "oxlint",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.44",
    "@hono/node-server": "^2.1.6",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "ai": "5.0.98",
    "croner": "^11.0.0",
    "dotenv": "^18.0.9",
    "fast-glob": "^3.3.3",
    "hono": "^4.13.17",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": [
      "pnpm run lint",
      "pnpm run fmt --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
